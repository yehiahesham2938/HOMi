# ─────────────────────────────────────────────────────────────────────────────
# HOMi API — environment variables
# Copy to `.env` for local dev. On Railway, set these in the service "Variables"
# tab (do NOT commit real secrets). Vars marked [REQUIRED IN PROD] must be set
# for the server to boot / function in production.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
# Railway injects PORT automatically — leave unset there. 3000 for local dev.
PORT=3000
# Public URL of the deployed frontend (used in emails / links). In production this
# defaults to https://homi-platform.com when unset; override here if needed.
CLIENT_URL=http://localhost:5173
# Comma-separated allowed browser origins for CORS + Socket.IO. In production this
# defaults to the deployed frontend (https://homi-platform.com) even when unset;
# set it here only to override, e.g. https://homi-platform.com,https://www.homi-platform.com
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
# [REQUIRED IN PROD] Prefer a single connection string (Railway Postgres provides
# DATABASE_URL automatically when you add the plugin / reference the variable).
# When DATABASE_URL is set it takes precedence and SSL is enabled in production.
DATABASE_URL=
# Used only when DATABASE_URL is empty (local dev).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=homi_db
DB_USER=postgres
DB_PASSWORD=
# Connection pool (optional — sensible defaults applied).
DB_POOL_MAX=10
DB_POOL_MIN=2
DB_POOL_ACQUIRE_MS=30000
DB_POOL_IDLE_MS=30000

# ── Auth / JWT ───────────────────────────────────────────────────────────────
# [REQUIRED IN PROD] Use long random strings (e.g. `openssl rand -hex 32`).
JWT_SECRET=dev-jwt-secret-change-in-production
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ── Encryption ───────────────────────────────────────────────────────────────
# [REQUIRED IN PROD] 64 hex chars (32 bytes). Generate: `openssl rand -hex 32`.
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ── Email (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=noreply@homi.com
SMTP_FROM_NAME=HOMi

# ── WebAuthn / Passkeys (optional) ───────────────────────────────────────────
# In prod these default to the homi-platform.com frontend (RP_ID=homi-platform.com,
# ORIGIN=https://homi-platform.com). Override only if the frontend host changes.
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGIN=

# ── Admin seed account ───────────────────────────────────────────────────────
ADMIN_SEED_EMAIL=Homi@admin.com
ADMIN_SEED_PASSWORD=HomiAdmin

# ── Paymob (payments) ────────────────────────────────────────────────────────
PAYMOB_BASE_URL=https://accept.paymob.com
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=0
PAYMOB_WALLET_INTEGRATION_ID=5607894
PAYMOB_IFRAME_ID=0
PAYMOB_WALLET_IFRAME_ID=0
PAYMOB_HMAC_SECRET=

# ── Google Gemini (AI features) ──────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-2.0-flash

# ── Redis (Upstash, REST) ────────────────────────────────────────────────────
# [REQUIRED] UPSTASH_* must be non-empty for the server to start (config schema
# requires them). REDIS_ENABLED is forced true in production; set the credentials
# from your Upstash database REST API page.
REDIS_ENABLED=false
UPSTASH_REDIS_REST_URL=https://example.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-me
REDIS_KEY_PREFIX=homi:

# ── Rate limiting (active when Redis enabled) ────────────────────────────────
RATE_LIMIT_ENABLED=false
RATE_LIMIT_WINDOW_SECONDS=600
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_PREFIX=homi:ratelimit:ip

# ── Caching (active when Redis enabled) ──────────────────────────────────────
CACHE_ENABLED=false
CACHE_PREFIX=homi:cache
CACHE_DEFAULT_TTL_SECONDS=600
CACHE_POPULAR_PROPERTIES_TTL_SECONDS=600
SESSION_TTL_SECONDS=900
