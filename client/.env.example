# ─────────────────────────────────────────────────────────────────────────────
# HOMi client — environment variables (Vite)
# Copy to `.env` for local dev. On Vercel, set these under
# Project → Settings → Environment Variables. Only VITE_*-prefixed vars are
# exposed to the browser bundle.
# ─────────────────────────────────────────────────────────────────────────────

# Base URL the frontend calls for the API.
# - Local dev: leave as "/api" (vite.config.ts proxies /api + /socket.io to :3000).
# - Production: the deployed backend is https://api.homi-platform.com/api, baked
#   into the build via client/.env.production. Set this only to override that, and
#   always include the trailing /api (Socket.IO derives its origin by stripping it).
VITE_API_BASE_URL=/api

# Google OAuth client ID (Google sign-in). From Google Cloud Console → Credentials.
VITE_GOOGLE_CLIENT_ID=

# Optional. Override the base origin used to resolve uploaded signature images.
# Leave empty to derive it from VITE_API_BASE_URL.
VITE_SIGNATURES_BASE_URL=
